@model RestBar.Interfaces.DiSimulationResult?
@{
    ViewData["Title"] = "Simulations";
}
<div class="container-fluid py-3">
    <h1 class="h3">Simulation Center</h1>
    <p class="text-muted">What-if en memoria. <strong>No modifica</strong> POS, caja ni inventario.</p>
    <form asp-action="RunSalesSimulation" method="post" class="row g-2 align-items-end mb-4">
        @Html.AntiForgeryToken()
        <div class="col-auto">
            <label class="form-label">Cambio de ventas %</label>
            <input class="form-control" type="number" step="0.1" name="pctChange" value="10" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" type="submit">Simular</button>
        </div>
    </form>
    @if (Model != null)
    {
        <div class="border rounded p-3">
            <div>Escenario: <strong>@Model.Scenario</strong></div>
            <div>Baseline: @Model.BaselineRevenue.ToString("N2")</div>
            <div>Simulado: @Model.SimulatedRevenue.ToString("N2")</div>
            <div>Delta: @Model.DeltaRevenue.ToString("N2")</div>
            <div class="small text-muted">@Model.Note</div>
        </div>
    }
    <a class="btn btn-outline-light btn-sm mt-3" asp-action="Cockpit">← Cockpit</a>
</div>
