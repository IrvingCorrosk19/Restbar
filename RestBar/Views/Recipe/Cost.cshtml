@model RestBar.Interfaces.PlateCostResult
@{
    ViewData["Title"] = "Costo de plato";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-3">
    <h2>Costo teórico del plato</h2>
    <dl class="row">
        <dt class="col-sm-3">Costo</dt><dd class="col-sm-9">@Model.TheoreticalCost.ToString("C")</dd>
        <dt class="col-sm-3">Precio</dt><dd class="col-sm-9">@Model.SellingPrice.ToString("C")</dd>
        <dt class="col-sm-3">Food Cost %</dt><dd class="col-sm-9">@Model.FoodCostPercent.ToString("F2")%</dd>
        <dt class="col-sm-3">Margen</dt><dd class="col-sm-9">@Model.GrossMargin.ToString("C") (@Model.GrossMarginPercent.ToString("F1")%)</dd>
    </dl>
    <table class="table table-sm">
        <thead><tr><th>Ingrediente</th><th>Qty</th><th>Waste%</th><th>Costo u.</th><th>Línea</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Lines)
        {
            <tr>
                <td>@l.Name</td>
                <td>@l.Qty.ToString("F4")</td>
                <td>@l.WastePercent.ToString("F1")</td>
                <td>@l.UnitCost.ToString("C")</td>
                <td>@l.LineCost.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
