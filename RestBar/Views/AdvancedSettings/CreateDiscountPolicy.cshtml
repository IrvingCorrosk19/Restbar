@model RestBar.Models.DiscountPolicy
@{
    ViewData["Title"] = "Nueva Política de Descuento";
    Layout = "_Layout";
}

<div class="container mt-3">
    <div class="d-flex justify-content-between mb-3">
        <h2>Nueva Política de Descuento</h2>
        <a class="btn btn-secondary" asp-action="DiscountPolicies">Volver</a>
    </div>

    <form asp-action="CreateDiscountPolicy" method="post" class="card card-body">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Nombre</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Descripción</label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="DiscountPercentage" class="form-label">Porcentaje de descuento (%)</label>
            <input asp-for="DiscountPercentage" class="form-control" type="number" step="0.01" min="0" />
        </div>

        <div class="mb-3">
            <label asp-for="MaximumDiscountAmount" class="form-label">Monto máximo de descuento</label>
            <input asp-for="MaximumDiscountAmount" class="form-control" type="number" step="0.01" min="0" />
        </div>

        <div class="mb-3">
            <label asp-for="MinimumOrderAmount" class="form-label">Monto mínimo del pedido</label>
            <input asp-for="MinimumOrderAmount" class="form-control" type="number" step="0.01" min="0" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="RequiresApproval" class="form-check-input" type="checkbox" />
            <label asp-for="RequiresApproval" class="form-check-label">Requiere aprobación</label>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ValidFromTime" class="form-label">Válido desde (hh:mm)</label>
                <input asp-for="ValidFromTime" class="form-control" placeholder="09:00" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ValidUntilTime" class="form-label">Válido hasta (hh:mm)</label>
                <input asp-for="ValidUntilTime" class="form-control" placeholder="18:00" />
            </div>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
            <label asp-for="IsActive" class="form-check-label">Activa</label>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
    </form>
</div>
