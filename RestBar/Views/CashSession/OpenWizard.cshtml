@{
    ViewData["Title"] = "Apertura de caja";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var registers = ViewBag.Registers as IEnumerable<RestBar.Models.CashRegister>;
}
<div class="container mt-3">
    <h2>Wizard — Apertura de sesión</h2>
    <form asp-action="Open" method="post" class="card p-4">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Caja registradora</label>
            <select name="registerId" class="form-select" required>
                @foreach (var r in registers ?? Enumerable.Empty<RestBar.Models.CashRegister>())
                {
                    <option value="@r.Id">@r.Code — @r.Name (fondo @r.DefaultOpeningFloat.ToString("C"))</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Fondo de apertura</label>
            <input name="openingFloat" type="number" step="0.01" class="form-control" value="100" required />
        </div>
        <button type="submit" class="btn btn-success">Abrir sesión</button>
    </form>
</div>
