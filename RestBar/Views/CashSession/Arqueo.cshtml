@model RestBar.Models.CashSession
@{
    ViewData["Title"] = "Arqueo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var expected = (decimal)ViewBag.ExpectedCash;
}
<div class="container mt-3">
    <h2>Arqueo — Sesión #@Model.SessionNumber</h2>
    <p>Efectivo esperado: <strong>@expected.ToString("C")</strong></p>
    <form asp-action="SubmitCount" method="post" class="card p-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="mb-3">
            <label class="form-label">Total contado</label>
            <input name="totalCounted" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="isBlind" value="true" id="blind" />
            <label class="form-check-label" for="blind">Cierre ciego</label>
        </div>
        <button type="submit" class="btn btn-primary">Enviar conteo</button>
    </form>
</div>
