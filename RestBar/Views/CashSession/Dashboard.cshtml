@{
    ViewData["Title"] = "Dashboard de Caja";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var snapshot = ViewBag.Snapshot;
    var activeSessions = ViewBag.ActiveSessions as IEnumerable<RestBar.Controllers.CashSessionController.CashSessionListItem>
        ?? Enumerable.Empty<RestBar.Controllers.CashSessionController.CashSessionListItem>();
    var activeCount = activeSessions.Count();
}
<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-cash-register"></i> Caja — Command Center</h2>
        <a class="btn btn-primary" asp-action="OpenWizard">Abrir sesión</a>
    </div>
    @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
    {
        <div class="alert alert-warning">@err</div>
    }
    <div class="row g-3">
        <div class="col-md-3">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h6>Sesiones activas</h6>
                    <h3>@activeCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-success">
                <div class="card-body">
                    <h6>Efectivo esperado</h6>
                    <h3>@(((decimal)(snapshot?.TotalExpectedCash ?? 0m)).ToString("C"))</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-info">
                <div class="card-body">
                    <h6>Ventas activas</h6>
                    <h3>@(((decimal)(snapshot?.TotalSalesActive ?? 0m)).ToString("C"))</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-secondary">
                <div class="card-body">
                    <h6>Cierres hoy</h6>
                    <h3>@(snapshot?.ClosedSessionsToday ?? 0)</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header"><strong>Sesiones activas</strong></div>
        <div class="card-body p-0">
            <table class="table mb-0" data-testid="cash-active-sessions">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Estado</th>
                        <th>Apertura</th>
                        <th>Esperado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in activeSessions)
                {
                    <tr>
                        <td>@s.SessionNumber</td>
                        <td>@s.Status</td>
                        <td>@s.OpenedAt.ToString("g")</td>
                        <td>@s.ExpectedCash.ToString("C")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Detail"
                               asp-route-id="@s.Id"
                               data-testid="cash-session-detail-link">Detalle</a>
                        </td>
                    </tr>
                }
                @if (activeCount == 0)
                {
                    <tr><td colspan="5" class="text-muted p-3">No hay sesiones activas. Abre una desde el wizard.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
