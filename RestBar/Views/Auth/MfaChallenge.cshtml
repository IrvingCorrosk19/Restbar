@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Verificación MFA";
}

<div class="login-form">
    <div class="form-title">
        <h2>Verificación en dos pasos</h2>
        <p>Ingresa el código de 6 dígitos de tu autenticador</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form method="post" asp-action="MfaChallenge" asp-controller="Auth" autocomplete="off">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <i class="fas fa-shield-alt"></i>
            <input type="text"
                   name="code"
                   class="form-control"
                   placeholder="000000"
                   inputmode="numeric"
                   pattern="[0-9]{6}"
                   maxlength="6"
                   required
                   autofocus
                   autocomplete="one-time-code"
                   aria-label="Código MFA de 6 dígitos" />
        </div>
        <button type="submit" class="btn btn-login">
            Verificar
        </button>
    </form>

    <div class="admin-link mt-3">
        <a href="@Url.Action("Login", "Auth")">Volver al inicio de sesión</a>
    </div>
</div>
