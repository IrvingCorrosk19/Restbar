@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="login-form">
    <div class="form-title">
        <h2>Nueva Contraseña</h2>
        <p>Ingresa tu nueva contraseña</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["Error"]
        </div>
    }

    <form method="post" asp-action="ResetPassword" asp-controller="Auth">
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@ViewData["Token"]" />
        <input type="hidden" name="email" value="@ViewData["Email"]" />

        <div class="form-group">
            <i class="fas fa-lock"></i>
            <input type="password"
                   name="newPassword"
                   class="form-control"
                   placeholder="Nueva contraseña"
                   required
                   minlength="6"
                   autocomplete="new-password" />
        </div>

        <div class="form-group">
            <i class="fas fa-lock"></i>
            <input type="password"
                   id="confirmPassword"
                   class="form-control"
                   placeholder="Confirmar contraseña"
                   required
                   minlength="6"
                   autocomplete="new-password" />
        </div>

        <button type="submit" class="btn btn-login">
            <i class="fas fa-key me-2"></i>
            Restablecer contraseña
        </button>
    </form>

    <div class="admin-link">
        <a href="@Url.Action("Login", "Auth")">
            <i class="fas fa-arrow-left me-1"></i>
            Volver al inicio de sesión
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function (e) {
            var pwd = document.querySelector('[name="newPassword"]').value;
            var confirm = document.getElementById('confirmPassword').value;
            if (pwd !== confirm) {
                e.preventDefault();
                alert('Las contraseñas no coinciden');
            }
        });
    </script>
}
