@model IEnumerable<RestBar.Models.Supplier>
@{
    ViewData["Title"] = "Proveedores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-3">
    <div class="d-flex justify-content-between mb-3">
        <h2>Proveedores</h2>
        <a class="btn btn-outline-primary" asp-controller="ProcurementDashboard" asp-action="Index">Command Center</a>
    </div>
    <table class="table table-striped">
        <thead><tr><th>Código</th><th>Nombre</th><th>Estado</th><th>Score</th><th>Lead</th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Code</td>
                <td>@s.Name @(s.IsPreferred ? "★" : "")</td>
                <td>@s.Status</td>
                <td>@s.ScoreOverall.ToString("F1")</td>
                <td>@s.LeadTimeDays d</td>
            </tr>
        }
        </tbody>
    </table>
</div>
