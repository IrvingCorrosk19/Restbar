@model RestBar.Models.PurchaseOrder
@{
    ViewData["Title"] = "Recepción — " + Model.PoNumber;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-3">
    <h2>Receiving Wizard — @Model.PoNumber</h2>
    <table class="table" id="lines">
        <thead><tr><th>Línea</th><th>Pedido</th><th>Recibido</th><th>Aceptado</th><th>Costo</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Lines)
        {
            var pending = l.QuantityOrdered - l.QuantityReceived;
            <tr data-line-id="@l.Id">
                <td>@l.ProductId.ToString()[..8]</td>
                <td>@l.QuantityOrdered</td>
                <td><input class="form-control qty-rec" type="number" step="0.01" value="@pending" /></td>
                <td><input class="form-control qty-acc" type="number" step="0.01" value="@pending" /></td>
                <td><input class="form-control unit-cost" type="number" step="0.01" value="@l.UnitPrice" /></td>
            </tr>
        }
        </tbody>
    </table>
    <button class="btn btn-success" id="btnComplete">Completar recepción</button>
    <div id="msg" class="mt-2"></div>
</div>
@section Scripts {
<script>
document.getElementById('btnComplete').addEventListener('click', async () => {
  const start = await fetch('@Url.Action("StartReceive", new { id = Model.Id })', { method: 'POST' });
  const started = await start.json();
  if (!started.success) { document.getElementById('msg').textContent = 'Error al iniciar'; return; }
  const lines = [...document.querySelectorAll('#lines tbody tr')].map(tr => ({
    purchaseOrderLineId: tr.dataset.lineId,
    qtyReceived: parseFloat(tr.querySelector('.qty-rec').value),
    qtyAccepted: parseFloat(tr.querySelector('.qty-acc').value),
    qtyRejected: 0,
    disposition: 'Accepted',
    unitCost: parseFloat(tr.querySelector('.unit-cost').value)
  }));
  const res = await fetch('@Url.Action("CompleteReceive")', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ receiptId: started.receiptId, lines })
  });
  const data = await res.json();
  document.getElementById('msg').textContent = data.success ? 'Recepción completada' : 'Error';
  if (data.success) location.href = '@Url.Action("Detail", new { id = Model.Id })';
});
</script>
}
