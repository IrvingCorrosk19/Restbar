@using RestBar.Domain.Analytics
@{
    var report = (AnalyticsReportDefinition)ViewBag.Report;
    ViewData["Title"] = report.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid mt-3" data-report-key="@report.Key">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Centro Ejecutivo</a></li>
            <li class="breadcrumb-item active">@report.Category</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
        <div>
            <h2 class="mb-1">@report.Title</h2>
            <p class="text-muted mb-0">@report.Description</p>
            <small class="text-muted">Fuente: <code>@report.ProcedureOrSource</code>
                @if (!string.IsNullOrEmpty(report.Limitation))
                {
                    <span class="badge text-bg-warning">@report.Limitation</span>
                }
            </small>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-start">
            <partial name="~/Views/Shared/Analytics/_FilterBar.cshtml" />
            <div class="btn-group">
                <a class="btn btn-sm btn-outline-secondary" id="btnCsv" href="#">CSV</a>
                <a class="btn btn-sm btn-outline-secondary" id="btnXlsx" href="#">Excel</a>
                <a class="btn btn-sm btn-outline-secondary" id="btnPdf" href="#">PDF</a>
                <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">Imprimir</button>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-4" id="reportMeta"></div>
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between">
                    <span>Gráfico</span>
                    <input class="form-control form-control-sm w-50" id="tblSearch" placeholder="Buscar en tabla..." />
                </div>
                <div class="card-body">
                    <canvas id="reportChart" height="120"></canvas>
                    <div id="chartEmpty" class="text-muted d-none">Sin datos para graficar</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between">
            <span>Detalle</span>
            <span class="small text-muted" id="rowCount"></span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0" id="reportTable">
                <thead></thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <button class="btn btn-sm btn-outline-secondary" id="btnPrev">Anterior</button>
            <span class="small" id="pageInfo"></span>
            <button class="btn btn-sm btn-outline-secondary" id="btnNext">Siguiente</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/analytics-report.js" asp-append-version="true"></script>
}
