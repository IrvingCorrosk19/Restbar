@{
    ViewData["Title"] = "Centro Ejecutivo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var reportGroups = (IEnumerable<IGrouping<string, RestBar.Domain.Analytics.AnalyticsReportDefinition>>)ViewBag.Reports;
}
<div class="container-fluid mt-3 analytics-center">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h2 class="mb-0">Centro Ejecutivo de Analytics</h2>
            <small class="text-muted">¿Qué ocurre ahora? · ¿Qué pasó y por qué? · ¿Qué decidir?</small>
        </div>
        <partial name="~/Views/Shared/Analytics/_FilterBar.cshtml" />
    </div>

    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-now" type="button">Ahora mismo</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-period" type="button">Rendimiento</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-decide" type="button">Decisiones</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-reports" type="button">Reportes</button></li>
    </ul>

    <div class="tab-content border border-top-0 p-3 bg-body">
        <div class="tab-pane fade show active" id="tab-now">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted small">Actualización cada 60s · sin saturar POS</span>
                <button class="btn btn-sm btn-outline-primary" id="btnRefreshLive">Actualizar</button>
            </div>
            <div class="row g-3" id="liveCards">
                <div class="col-12"><div class="placeholder-glow"><span class="placeholder col-12" style="height:80px"></span></div></div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-period">
            <div class="row g-3 mb-3" id="periodKpis"></div>
            <div class="row g-3">
                <div class="col-lg-7"><div class="card"><div class="card-header">Tendencia de ventas</div><div class="card-body"><canvas id="chartTrend" height="140"></canvas></div></div></div>
                <div class="col-lg-5"><div class="card"><div class="card-header">Comparación vs periodo anterior</div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm mb-0" id="tblCompare"><thead><tr><th>Métrica</th><th>Actual</th><th>Anterior</th><th>Δ%</th></tr></thead><tbody></tbody></table></div></div></div></div>
            </div>
        </div>

        <div class="tab-pane fade" id="tab-decide">
            <p class="small text-muted">Reglas determinísticas verificables. Las marcadas como inferencia no son certezas.</p>
            <div id="decisionList" class="vstack gap-2"></div>
        </div>

        <div class="tab-pane fade" id="tab-reports">
            @foreach (var g in reportGroups)
            {
                <h5 class="mt-3">@g.Key</h5>
                <div class="row g-2">
                @foreach (var r in g)
                {
                    <div class="col-md-4 col-lg-3">
                        <a class="card text-decoration-none h-100" href="@Url.Action("Report", new { key = r.Key })">
                            <div class="card-body">
                                <strong>@r.Title</strong>
                                <div class="small text-muted">@r.Description</div>
                                @if (r.Availability == RestBar.Domain.Analytics.KpiAvailability.AvailableWithLimitations)
                                {
                                    <span class="badge text-bg-warning mt-1">Limitaciones</span>
                                }
                            </div>
                        </a>
                    </div>
                }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/analytics-center.js" asp-append-version="true"></script>
}
